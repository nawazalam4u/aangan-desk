# Copy to .env for local use (python3 dev_server.py). On Vercel add these under Settings > Environment Variables.
# --- AI (pick ONE; with neither, the site runs in demo mode with a rules-based voice) ---
ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# --- Telegram handoff (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
# --- Shared database so the dashboard sees every call (optional) ---
DATABASE_URL=
DASHBOARD_KEY=
